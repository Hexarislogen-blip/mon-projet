# Configuration PHP pour le formulaire de contact
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log /tmp/php_contact_errors.log
    php_value upload_max_filesize 2M
    php_value post_max_size 2M
    php_value max_execution_time 30
    php_value max_input_time 30
</IfModule>

# Sécurité
<FilesMatch "\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# CORS Headers (déjà dans le PHP mais en backup)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Bloquer l'accès direct aux fichiers sensibles
<FilesMatch "\.(log|ini|conf)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
